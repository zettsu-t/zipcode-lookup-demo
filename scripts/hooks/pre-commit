#!/bin/sh
# git pre-commit hook
# - ruff format / check を実行する
# - backend/ が変更されていたら OpenAPI スキーマを再生成してステージングする
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
RUFF="$REPO_ROOT/.venv/bin/ruff"
PYTHON="$REPO_ROOT/.venv/bin/python"

cd "$REPO_ROOT"

# ruff format（自動修正 → 変更があればステージングに追加）
"$RUFF" format backend/ frontend/
git add -u -- backend/ frontend/

# ruff check（修正不可の問題があれば失敗）
"$RUFF" check backend/ frontend/

# backend/ のファイルがステージされていたらスキーマを再生成
if git diff --cached --name-only | grep -q '^backend/'; then
    "$PYTHON" scripts/export_openapi.py > docs/openapi_spec.yaml
    git add docs/openapi_spec.yaml
fi
