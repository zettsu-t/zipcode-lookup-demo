# デフォルト：LF統一
* text=auto eol=lf

# Python
*.py text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# 設定ファイル
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf

# シェルスクリプト
*.sh text eol=lf

# Windows固有（念のため）
*.bat text eol=crlf
*.cmd text eol=crlf

# バイナリ
*.png binary
*.jpg binary
*.ico binary
*.gz binary
*.zip binary
